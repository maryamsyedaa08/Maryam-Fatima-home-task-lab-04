#include <stdio.h>
int main()
{
    float a, b, c;
    
    printf("Enter the lengths of 3 sides of triangle: ");
    scanf("%f %f %f", &a, &b, &c);
    
    if (a + b > c && b + c > a && a + c > b) 
    {
        printf("Valid Triangle\n");
        
        if (a == b && b == c) 
        {
            printf("Type: Equilateral Triangle\n");
        }
        else if (a == b || b == c || a == c)
        {
            printf("Type: Isosceles Triangle\n");
        }
        else if(a!=b || b!=c || a!=c) 
        {
            printf("Type: Scalene Triangle\n");
        }
    }
    else {
        printf("The given sides cannot form a triangle\n");
    }
    
}
